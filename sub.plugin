[Plugin]
#!name=Sub 去广告
#!desc=拦截 HAR 中识别到的开屏广告 SDK、广告投放请求及站内广告列表接口
#!author=Pialabiala
#!homepage=https://github.com/Pialabiala/subads-loon
#!date=2026-10-31

[Rule]
# 站内广告列表接口（响应为应用层加密数据，按 URL 精确拦截）
URL-REGEX,^https?://sublifeapp\.com/fem/api/advertisement/findList(?:\?|$),REJECT

# HAR 中实际出现的广告 SDK / 广告投放域名
DOMAIN,inner.hzzfcm.com,REJECT
DOMAIN,sdk.hzzfcm.com,REJECT
DOMAIN,sdkconf.buluken.com,REJECT
DOMAIN,bid.buluken.com,REJECT
DOMAIN,sl.buluken.com,REJECT
DOMAIN,evapi.xunruns.com,REJECT
DOMAIN,tk2.vlion.cn,REJECT
DOMAIN,impdsp.meituan.com,REJECT
DOMAIN,t.hs.lingjuad.com,REJECT
DOMAIN,inner-report.shunchangzhixing.com,REJECT
